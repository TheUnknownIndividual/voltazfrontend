<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Dynamic Sitemap" stopProcessing="true">
          <match url="^sitemap\.xml$" />
          <action type="Rewrite" url="https://api.volt.az/api/seo/sitemap.xml" />
        </rule>
        <rule name="Dynamic Robots" stopProcessing="true">
          <match url="^robots\.txt$" />
          <action type="Rewrite" url="https://api.volt.az/api/seo/robots.txt" />
        </rule>
        <rule name="API Catalog Well Known" stopProcessing="true">
          <match url="^\.well-known/api-catalog$" />
          <action type="Rewrite" url="/.well-known/api-catalog.linkset" />
        </rule>
        <rule name="OpenID Configuration Well Known" stopProcessing="true">
          <match url="^\.well-known/openid-configuration$" />
          <action type="Rewrite" url="/.well-known/openid-configuration.json" />
        </rule>
        <rule name="OAuth Authorization Server Well Known" stopProcessing="true">
          <match url="^\.well-known/oauth-authorization-server$" />
          <action type="Rewrite" url="/.well-known/oauth-authorization-server.json" />
        </rule>
        <rule name="JWKS Well Known" stopProcessing="true">
          <match url="^\.well-known/jwks\.json$" />
          <action type="Rewrite" url="/.well-known/jwks.json" />
        </rule>
        <rule name="Markdown For Agents" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_ACCEPT}" pattern="(^|,|\s)text/markdown($|,|;)" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.md" />
        </rule>
        <rule name="IndexNow Key File" stopProcessing="true">
          <match url="^[A-Za-z0-9_-]{8,128}\.txt$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="https://api.volt.az/api/seo/indexnow-key.txt" />
        </rule>
        <rule name="SPA Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Ignore existing files -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- Ignore existing directories -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- Skip API routes if your API is served from the same host -->
            <add input="{REQUEST_URI}" pattern="^/api" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown" />
      <mimeMap fileExtension=".linkset" mimeType="application/linkset+json" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="Link" value="&lt;/.well-known/api-catalog&gt;; rel=&quot;api-catalog&quot;, &lt;/.well-known/openid-configuration&gt;; rel=&quot;openid-configuration&quot;, &lt;/robots.txt&gt;; rel=&quot;robots&quot;, &lt;/sitemap.xml&gt;; rel=&quot;sitemap&quot;, &lt;/llms.txt&gt;; rel=&quot;service-doc&quot;" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
