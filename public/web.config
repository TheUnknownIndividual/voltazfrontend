<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Canonical production host" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.volt\.az$" />
          </conditions>
          <action type="Redirect" url="https://volt.az/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Require HTTPS on known hosts" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^(volt\.az|test\.volt\.az)$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Canonical installation landing page" stopProcessing="true">
          <match url="^solar-installation/?$" ignoreCase="true" />
          <action type="Redirect" url="/gunes-paneli-qurasdirilmasi" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Canonical solar panel landing aliases" stopProcessing="true">
          <match url="^(?:solar-panels|gunes-panel|gunes-paneli|gunes-paneller|gunes-panelleri-satisi|solar-panel)/?$" ignoreCase="true" />
          <action type="Redirect" url="/gunes-panelleri" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Canonical inverter landing aliases" stopProcessing="true">
          <match url="^(?:inverters|inverter|invertor|inventor|gunes-inverter|gunes-invertor|gunes-inventor|gunes-panel-inverter|gunes-panel-invertor)/?$" ignoreCase="true" />
          <action type="Redirect" url="/gunes-invertorlari" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Canonical credit route" stopProcessing="true">
          <match url="^((?:en|ru|tr)/)?credit/?$" ignoreCase="true" />
          <action type="Redirect" url="/{R:1}credits" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Canonical video route" stopProcessing="true">
          <match url="^((?:en|ru|tr)/)?reels/?$" ignoreCase="true" />
          <action type="Redirect" url="/{R:1}videos" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Canonical terms route" stopProcessing="true">
          <match url="^((?:en|ru|tr)/)?terms/?$" ignoreCase="true" />
          <action type="Redirect" url="/{R:1}terms-of-service" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Remove trailing slash" stopProcessing="true">
          <match url="^(.+)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Removed compromised namespaces" stopProcessing="true">
          <match url="^(?:(?:llmaictiaorg|test12aictiaorg)(?:/.*)?|(?:node_modules|vendor)(?:/.*)?|.*(?:node_modules|vendor)/.*|.*\.mjs\.map)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="This URL has been permanently removed." />
        </rule>
        <!-- sitemap.xml and robots.txt are static public files refreshed by
             the deployment build and the isolated daily SEO task. -->
        <rule name="API Catalog Well Known" stopProcessing="true">
          <match url="^\.well-known/api-catalog$" />
          <action type="Rewrite" url="/.well-known/api-catalog.linkset" />
        </rule>
        <rule name="OpenID Configuration Well Known" stopProcessing="true">
          <match url="^\.well-known/openid-configuration$" />
          <action type="Rewrite" url="/.well-known/openid-configuration.json" />
        </rule>
        <rule name="OAuth Authorization Server Well Known" stopProcessing="true">
          <match url="^\.well-known/oauth-authorization-server$" />
          <action type="Rewrite" url="/.well-known/oauth-authorization-server.json" />
        </rule>
        <rule name="JWKS Well Known" stopProcessing="true">
          <match url="^\.well-known/jwks\.json$" />
          <action type="Rewrite" url="/.well-known/jwks.json" />
        </rule>
        <rule name="Markdown For Agents" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_ACCEPT}" pattern="(^|,|\s)text/markdown($|,|;)" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.md" />
        </rule>
        <rule name="IndexNow Key File" stopProcessing="true">
          <match url="^[A-Za-z0-9_-]{8,128}\.txt$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="https://api.volt.az/api/seo/indexnow-key.txt" />
        </rule>
        <rule name="Block direct prerender storage access" stopProcessing="true">
          <match url="^_prerender(?:_[0-9a-f]{12})?(?:/.*)?$" ignoreCase="true" />
          <conditions>
            <add input="{THE_REQUEST}" pattern="\s/+_prerender(?:_[0-9a-f]{12})?(?:/|\s)" />
          </conditions>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="The requested Volt.az page was not found." />
        </rule>
        <rule name="Prerendered extensionless HTML" stopProcessing="true">
          <match url="^(.+)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{APPL_PHYSICAL_PATH}__PRERENDER_DIR__\{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/__PRERENDER_DIR__/{R:1}.html" />
        </rule>
        <rule name="Authenticated and live dynamic SPA routes" stopProcessing="true">
          <match url="^(admin-dashboard(?:/.*)?|customer-dashboard(?:/.*)?|pro-club/dashboard(?:/.*)?|cart|checkout|order(?:/.*)?|theme-lab|contact/confirm/[^/]+|(?:en/|ru/|tr/)?(?:product|projects|blog|news)/[^/]+)$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
        <rule name="Unknown route is a real 404" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api" negate="true" />
          </conditions>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="The requested Volt.az page was not found." />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Noindex test environment">
          <match serverVariable="RESPONSE_X_ROBOTS_TAG" pattern=".*" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^test\.volt\.az$" />
          </conditions>
          <action type="Rewrite" value="noindex, nofollow, noarchive" />
        </rule>
      </outboundRules>
    </rewrite>
    <directoryBrowse enabled="false" />
    <httpErrors errorMode="Custom" existingResponse="Auto" defaultResponseMode="File">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown" />
      <mimeMap fileExtension=".linkset" mimeType="application/linkset+json" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="Link" value="&lt;/.well-known/api-catalog&gt;; rel=&quot;api-catalog&quot;, &lt;/.well-known/openid-configuration&gt;; rel=&quot;openid-configuration&quot;, &lt;/robots.txt&gt;; rel=&quot;robots&quot;, &lt;/sitemap.xml&gt;; rel=&quot;sitemap&quot;, &lt;/llms.txt&gt;; rel=&quot;service-doc&quot;" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
